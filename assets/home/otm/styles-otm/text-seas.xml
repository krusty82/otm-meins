<Style name="text-seas">
 
<Rule>
                &maxscale_zoom5;
                &minscale_zoom10;
        <Filter>[label] = 'sea'</Filter>
                <TextSymbolizer fontset-name="sans-oblique" fill="#2020ff" halo-radius="1" halo-fill="rgba(255,255,255,0.8)" max-char-angle-delta="0" smooth="0.5"  placement="point" s>
            <Placement size="11"/>
            <Placement size="10"/>
            <Placement size="9"/>
        </TextSymbolizer>
 </Rule>
